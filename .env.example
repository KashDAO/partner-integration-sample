# Your Kash partner API key. On staging it starts with kash_test_; Kash sends
# it to you when you ask for partner access. Keep it on your server only.
KASH_API_KEY=

# Optional: the API to call. Leave it unset and the SDK picks it from the key:
# kash_test_ goes to staging (test USDC on Solana devnet), kash_live_ to
# production (real USDC). A value set here wins, so a staging URL left in
# place sends a live key to staging, which refuses it.
# KASH_BASE_URL=https://api-staging.kash.bot/v1

# The signing secret for your webhook endpoint (whsec_...). Kash sends it with
# your key. Only `npm run webhooks` needs it.
KASH_WEBHOOK_SECRET=

# The port `npm run webhooks` listens on.
PORT=3000
